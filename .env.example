# Bot token from @BotFather (@PolozNewsbot)
TELEGRAM_BOT_TOKEN=

# Channel @PolozNewss or numeric id
TELEGRAM_CHANNEL_ID=@PolozNewss

# Regular cadence
MAX_POSTS_PER_CYCLE=1
MAX_POSTS_PER_DAY=10
MIN_MINUTES_BETWEEN_POSTS=90

# Urgent / breaking (mode=important) — outside the regular daily cap
MAX_URGENT_PER_DAY=5
MIN_MINUTES_BETWEEN_URGENT=20
