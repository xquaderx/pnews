# Bot token from @BotFather (@PolozNewsbot)
TELEGRAM_BOT_TOKEN=

# Channel @PolozNewss or numeric id
TELEGRAM_CHANNEL_ID=@PolozNewss

# Cadence (small news channel: ~6–10/day, spaced)
# LiveDune/Skillbox: 4+ posts/day cuts reach 30–40%; news OK a bit higher if spaced.
MAX_POSTS_PER_CYCLE=1
MAX_POSTS_PER_DAY=8
MIN_MINUTES_BETWEEN_POSTS=90
